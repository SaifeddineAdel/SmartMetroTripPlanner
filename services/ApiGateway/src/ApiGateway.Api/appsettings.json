{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "trip-planning-route": {
        "ClusterId": "trip-planning-cluster",
        "Match": {
          "Path": "/api/trips/{**catch-all}"
        },
        "Order": 0
      },
      "metro-network-route": {
        "ClusterId": "metro-network-cluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        },
        "Order": 10
      }
    },
    "Clusters": {
      "metro-network-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7174/"
          }
        }
      },
      "trip-planning-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7097/"
          }
        }
      }
    }
  }
}
